TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRY_RUN=true

RUN_INTERVAL_SECONDS=60
RSS_MAX_AGE_HOURS=24

WATCHLIST_PATH=data/nifty_watchlist.csv
PROCESSED_STORE_PATH=data/processed_news.json

SENTIMENT_MODEL=ProsusAI/finbert
SENTIMENT_POSITIVE_THRESHOLD=0.80
SENTIMENT_NEGATIVE_THRESHOLD=0.80

RSI_BUY_THRESHOLD=35
RSI_SELL_THRESHOLD=70
VOLUME_SPIKE_THRESHOLD=1.5
MIN_ALERT_SCORE=3
ALERT_ACTIONS=BUY,HOLD,SELL

DOCUMENTS_PATH=documents
CHROMA_PATH=chroma_db
RAG_COLLECTION=financial_reports
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_TIMEOUT_SECONDS=60
